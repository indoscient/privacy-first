# --- Keys ---
# Generated by running: npx ts-node src/generate-keypair.ts
PRIVATE_KEY=your_base64_private_key_here
API_KEY=generate_a_long_random_string_here

# --- CORS ---
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
PORT=4000

# --- Generate a strong API key with:
