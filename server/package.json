{
  "name": "@indoscient/privacy-first-server",
  "version": "0.1.9",
  "private": true,
  "description": "Express backend for the privacy-first demo: sealed-box decryption, key generation, auth middleware",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "gen:keypair": "ts-node src/generate-keypair.ts",
    "sanity": "ts-node src/sanity-check.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "typescript",
    "libsodium"
  ],
  "author": "Suman Jangili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indoscient/privacy-first.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/indoscient/privacy-first/issues"
  },
  "homepage": "https://privacy.indoscient.in",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "libsodium-wrappers": "^0.8.4"
  }
}
